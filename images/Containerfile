ARG TERRAFORM_VERSION=1.17.2

FROM docker.io/hashicorp/terraform:${TERRAFORM_VERSION}

ARG PODMAN_VERSION=6.2.0
ARG TARGETARCH

RUN wget -qO- "https://github.com/podman-container-tools/podman/releases/download/v${PODMAN_VERSION}/podman-remote-static-linux_${TARGETARCH}.tar.gz" \
      | tar xz -C /tmp \
 && mv "/tmp/bin/podman-remote-static-linux_${TARGETARCH}" /usr/local/bin/podman \
 && rm -rf /tmp/bin \
 && podman --version

# podman-remote talks to the socket mounted by the wrapper.
ENV CONTAINER_HOST=unix:///run/podman/podman.sock \
    KIND_EXPERIMENTAL_PROVIDER=podman