
kubeconfig := source_directory() / ".kube/config"

# Exports the kubeconfig to the .kube/config file
tf_export_kubeconfig:
    @echo "Exporting kubeconfig to {{kubeconfig}}"
    cd "{{source_directory()}}" && terraform output -raw kubeconfig > "{{kubeconfig}}" </dev/null

# Print env exports in your shell's syntax
tf_env shell=`basename "$SHELL"`:
    #!/usr/bin/env bash
    case "{{shell}}" in
      bash|zsh) echo "To setup your environment, run: export KUBECONFIG={{kubeconfig}}" ;;
      fish)     echo "To setup your environment, run: set -gx KUBECONFIG {{kubeconfig}}" ;;
      *)        echo "Unsupported shell: {{shell}}" >&2; exit 1 ;;
    esac
   
tf_destroy:
    @echo "Destroying Terraform resources..."
    cd "{{source_directory()}}" && terraform destroy -auto-approve
    @echo "Terraform resources destroyed."