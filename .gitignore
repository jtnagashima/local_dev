# Terraform working directory
**/.terraform/*
**/tf/.terraform.d/


# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files (may contain sensitive values)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform plan files
*.tfplan
tfplan

# Terraform lock file
# Keep this file committed to ensure consistent provider versions.
# .terraform.lock.hcl

# Sensitive files
*.pem
*.key
*.p12
*.pfx

# Editor / IDE files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
